# ==================== MySQL ====================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=rag_db
MYSQL_USER=root

# ==================== Redis ====================
REDIS_PASSWORD=redis123

# ==================== MinIO ====================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=rag-documents

# ==================== JWT ====================
JWT_SECRET=your-256-bit-secret-key-change-in-production

# ==================== 应用配置 (Spring Boot 环境变量覆盖) ====================
# 这些值对应 docker-compose 中的服务名，单独部署时改为实际IP
MYSQL_HOST=mysql
MYSQL_PORT=3306
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MINIO_ENDPOINT=http://minio:9000

# Python AI gRPC 服务地址 (由AI团队维护，部署时填写实际地址)
GRPC_RETRIEVAL_HOST=rag-python-retrieval
GRPC_RETRIEVAL_PORT=50051
GRPC_GENERATION_HOST=rag-python-generation
GRPC_GENERATION_PORT=50052

# Spring Profile: dev | prod
SPRING_PROFILES_ACTIVE=prod
